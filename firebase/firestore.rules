rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validProfile(data, uid) {
      return data.keys().hasAll(['id', 'authUserId', 'firstName', 'lastName', 'countryCode', 'locale', 'policyVersion', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'authUserId', 'firstName', 'lastName', 'countryCode', 'locale', 'policyVersion', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.matches('[a-zA-Z0-9]{20}')
        && data.authUserId == uid
        && data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 80
        && data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 80
        && data.countryCode == 'CL' && data.locale == 'es'
        && data.policyVersion == 'dev-access-2026-09-08'
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    match /profiles/{uid} {
      allow get: if owner(uid);
      allow create: if owner(uid) && validProfile(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/profiles/$(uid)/consents/dev-access-2026-09-08).data.acceptedAt == request.time;
      allow update: if owner(uid) && validProfile(request.resource.data, uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName', 'updatedAt']);
      match /consents/{version} {
        allow get: if owner(uid);
        allow create: if owner(uid) && version == 'dev-access-2026-09-08'
          && request.resource.data.keys().hasAll(['authUserId', 'policyVersion', 'context', 'accepted', 'acceptedAt'])
          && request.resource.data.keys().hasOnly(['authUserId', 'policyVersion', 'context', 'accepted', 'acceptedAt'])
          && request.resource.data.authUserId == uid
          && request.resource.data.policyVersion == version
          && request.resource.data.context == 'development-registration'
          && request.resource.data.accepted == true
          && request.resource.data.acceptedAt == request.time
          && getAfter(/databases/$(database)/documents/profiles/$(uid)).data.policyVersion == version;
      }
    }
    function draftOwner(uid) {
      return owner(uid) && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/profiles/$(uid));
    }
    function validBirthDate(data) {
      return data is map && data.keys().hasAll(['year', 'month', 'day'])
        && data.keys().hasOnly(['year', 'month', 'day'])
        && data.year is int && data.year >= 1900 && data.year <= request.time.year()
        && data.month is int && data.month >= 1 && data.month <= 12
        && data.day is int && data.day >= 1 && data.day <= 31
        && timestamp.date(data.year, data.month, data.day).year() == data.year
        && timestamp.date(data.year, data.month, data.day).month() == data.month
        && timestamp.date(data.year, data.month, data.day).day() == data.day
        && timestamp.date(data.year, data.month, data.day) <= request.time.date();
    }
    function validClinicalContext(data) {
      return data is map
        && data.keys().hasAll(['schemaVersion', 'patientContext', 'knownDiagnosis', 'symptomEvolution', 'medicalHistory', 'allergies', 'questions', 'studySummary', 'specialty', 'modality'])
        && data.keys().hasOnly(['schemaVersion', 'patientContext', 'knownDiagnosis', 'symptomEvolution', 'medicalHistory', 'allergies', 'questions', 'studySummary', 'specialty', 'modality', 'birthDate'])
        && (!('birthDate' in data) || validBirthDate(data.birthDate))
        && data.schemaVersion == 1
        && data.patientContext is string && data.patientContext.size() <= 4000
        && data.knownDiagnosis is string && data.knownDiagnosis.size() <= 4000
        && data.symptomEvolution is string && data.symptomEvolution.size() <= 4000
        && data.medicalHistory is string && data.medicalHistory.size() <= 4000
        && data.allergies is string && data.allergies.size() <= 4000
        && data.questions is string && data.questions.size() <= 4000
        && data.studySummary is string && data.studySummary.size() <= 4000
        && data.specialty is string && data.specialty.size() <= 4000
        && data.modality in ['', 'document_review', 'review_and_consultation'];
    }
    function validDraft(data, uid) {
      return data.keys().hasAll(['id', 'authUserId', 'patientId', 'countryCode', 'status', 'environment', 'policyVersion', 'reason', 'details', 'medicines', 'specialTreatments', 'previousProposals', 'revision', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'authUserId', 'patientId', 'countryCode', 'status', 'environment', 'policyVersion', 'reason', 'details', 'medicines', 'specialTreatments', 'previousProposals', 'clinicalContext', 'revision', 'createdAt', 'updatedAt'])
        && (!('clinicalContext' in data) || validClinicalContext(data.clinicalContext))
        && data.id is string && data.id.matches('[a-zA-Z0-9]{20}')
        && data.authUserId == uid
        && data.patientId == get(/databases/$(database)/documents/profiles/$(uid)).data.id
        && data.countryCode == get(/databases/$(database)/documents/profiles/$(uid)).data.countryCode
        && data.countryCode == 'CL' && data.status == 'draft' && data.environment == 'development'
        && data.policyVersion == 'dev-draft-storage-2026-09-08'
        && data.reason is string && data.reason.size() <= 4000
        && data.details is string && data.details.size() <= 4000
        && data.medicines is string && data.medicines.size() <= 4000
        && data.specialTreatments is string && data.specialTreatments.size() <= 4000
        && data.previousProposals is string && data.previousProposals.size() <= 4000
        && data.revision is int && data.revision > 0
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    match /consultationDrafts/{uid} {
      allow get: if draftOwner(uid);
      allow create: if draftOwner(uid) && validDraft(request.resource.data, uid)
        && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/consultationDrafts/$(uid)/consents/dev-draft-storage-2026-09-08).data.acceptedAt == request.time;
      allow update: if draftOwner(uid) && validDraft(request.resource.data, uid)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reason', 'details', 'medicines', 'specialTreatments', 'previousProposals', 'clinicalContext', 'revision', 'updatedAt']);
      match /consents/{version} {
        allow get: if draftOwner(uid);
        allow create: if draftOwner(uid) && version == 'dev-draft-storage-2026-09-08'
          && request.resource.data.keys().hasAll(['draftId', 'authUserId', 'policyVersion', 'context', 'accepted', 'acceptedAt'])
          && request.resource.data.keys().hasOnly(['draftId', 'authUserId', 'policyVersion', 'context', 'accepted', 'acceptedAt'])
          && request.resource.data.authUserId == uid && request.resource.data.policyVersion == version
          && request.resource.data.context == 'development-draft-storage' && request.resource.data.accepted == true
          && request.resource.data.acceptedAt == request.time
          && getAfter(/databases/$(database)/documents/consultationDrafts/$(uid)).data.id == request.resource.data.draftId
          && getAfter(/databases/$(database)/documents/consultationDrafts/$(uid)).data.policyVersion == version;
      }
    }
    function intakeOperator(country) {
      let staff = get(/databases/$(database)/documents/panelStaff/$(request.auth.uid)).data;
      return request.auth != null && request.auth.token.email_verified == true
        && staff.active == true && staff.provisioning == 'ready'
        && 'operations' in staff.memberships.get(country, []);
    }
    function validSubmissionAttachments(data, uid, intake) {
      return !('attachmentBatch' in data)
        ? !exists(/databases/$(database)/documents/draftAttachments/$(uid))
          && !existsAfter(/databases/$(database)/documents/draftAttachments/$(uid))
          && intake.get('documentCount', 0) == 0 && intake.get('hasVideo', false) == false
        : data.policyVersion == 'dev-submission-2026-09-09'
          && data.attachmentBatch == get(/databases/$(database)/documents/draftAttachments/$(uid)).data
          && data.attachmentBatch == getAfter(/databases/$(database)/documents/draftAttachments/$(uid)).data
          && intake.documentCount == data.attachmentBatch.count - data.attachmentBatch.get('videoCount', 0)
          && intake.hasVideo == (data.attachmentBatch.get('videoCount', 0) == 1);
    }
    function validSubmission(data, uid) {
      let draft = get(/databases/$(database)/documents/consultationDrafts/$(uid)).data;
      let intake = getAfter(/databases/$(database)/documents/intakeRequests/$(data.id)).data;
      return data.keys().hasAll(['id', 'authUserId', 'countryCode', 'revision', 'environment', 'status', 'policyVersion', 'accepted', 'submittedAt', 'draft'])
        && data.keys().hasOnly(['id', 'authUserId', 'countryCode', 'revision', 'environment', 'status', 'policyVersion', 'accepted', 'submittedAt', 'draft', 'attachmentBatch'])
        && data.id == draft.id && data.authUserId == uid
        && data.countryCode == 'CL' && data.countryCode == draft.countryCode
        && data.revision == draft.revision && data.draft == draft
        && draft.reason.matches('(?s).*[^\\s].*') && draft.details.matches('(?s).*[^\\s].*')
        && draft.clinicalContext.modality in ['document_review', 'review_and_consultation']
        && data.environment == 'development' && data.status == 'received'
        && data.policyVersion in ['dev-submission-2026-09-08', 'dev-submission-2026-09-09'] && data.accepted == true
        && data.submittedAt == request.time
        && validSubmissionAttachments(data, uid, intake)
        && intake.id == data.id && intake.countryCode == data.countryCode
        && intake.createdAt == request.time && intake.status == 'received'
        && intake.mode == draft.clinicalContext.modality;
    }
    match /consultationSubmissions/{uid} {
      allow get: if draftOwner(uid);
      allow create: if draftOwner(uid) && validSubmission(request.resource.data, uid);
    }
    match /intakeRequests/{id} {
      allow get: if intakeOperator(resource.data.countryCode)
        || (draftOwner(request.auth.uid)
          && get(/databases/$(database)/documents/consultationSubmissions/$(request.auth.uid)).data.id == id);
      allow list: if request.query.limit != null && request.query.limit <= 9
        && intakeOperator(resource.data.countryCode);
      allow create: if draftOwner(request.auth.uid)
        && request.resource.data.keys().hasAll(['id', 'countryCode', 'mode', 'createdAt', 'status', 'environment'])
        && request.resource.data.keys().hasOnly(['id', 'countryCode', 'mode', 'createdAt', 'status', 'environment', 'documentCount', 'hasVideo'])
        && request.resource.data.get('documentCount', 0) is int
        && request.resource.data.get('documentCount', 0) >= 0 && request.resource.data.get('documentCount', 0) <= 20
        && request.resource.data.get('hasVideo', false) is bool
        && request.resource.data.id == id && id.matches('[a-zA-Z0-9]{20}')
        && request.resource.data.countryCode == 'CL'
        && request.resource.data.mode in ['document_review', 'review_and_consultation']
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'received' && request.resource.data.environment == 'development'
        && !exists(/databases/$(database)/documents/consultationSubmissions/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/consultationSubmissions/$(request.auth.uid)).data.id == id
        && getAfter(/databases/$(database)/documents/consultationSubmissions/$(request.auth.uid)).data.submittedAt == request.time;
    }
    function isVideo(data) {
      return data.mimeType in ['video/mp4', 'video/quicktime'];
    }
    function validAttachmentFile(data) {
      return ((data.mimeType == 'image/jpeg' && data.fileName.matches('(?i).+[.](jpg|jpeg)'))
        || (data.mimeType == 'image/png' && data.fileName.matches('(?i).+[.]png'))
        || (data.mimeType == 'application/pdf' && data.fileName.matches('(?i).+[.]pdf'))
        || (data.mimeType == 'application/msword' && data.fileName.matches('(?i).+[.]doc'))
        || (data.mimeType == 'application/vnd.ms-excel' && data.fileName.matches('(?i).+[.]xls'))
        || (data.mimeType == 'video/mp4' && data.fileName.matches('(?i).+[.]mp4'))
        || (data.mimeType == 'video/quicktime' && data.fileName.matches('(?i).+[.]mov')))
        && (isVideo(data)
          ? data.size <= 20971520 && data.durationMilliseconds is int
            && data.durationMilliseconds > 0 && data.durationMilliseconds <= 30000
          : data.size <= 5242880 && !data.keys().hasAny(['durationMilliseconds']));
    }
    function validAttachment(data, uid, documentId) {
      return data.keys().hasAll(['id', 'authUserId', 'draftId', 'countryCode', 'title', 'fileName', 'size', 'mimeType', 'checksum', 'storageBackendId', 'objectKey', 'policyVersion', 'acceptedAt', 'createdAt'])
        && data.keys().hasOnly(['id', 'authUserId', 'draftId', 'countryCode', 'title', 'fileName', 'size', 'mimeType', 'checksum', 'storageBackendId', 'objectKey', 'policyVersion', 'acceptedAt', 'createdAt', 'durationMilliseconds'])
        && documentId.matches('[a-f0-9]{64}') && data.id == documentId && data.authUserId == uid
        && data.draftId == get(/databases/$(database)/documents/consultationDrafts/$(uid)).data.id
        && data.countryCode == 'CL'
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 255
        && data.size is int && data.size > 0 && validAttachmentFile(data)
        && data.checksum is string && data.checksum.matches('[a-f0-9]{64}')
        && data.storageBackendId == 'firebase-development-v1'
        && data.objectKey == 'private-drafts/' + uid + '/' + data.draftId + '/' + documentId
        && data.policyVersion == 'dev-files-2026-09-08'
        && data.acceptedAt == request.time && data.createdAt == request.time;
    }
    function validAttachmentQuota(data, uid) {
      let documentId = data.lastDocumentId;
      let previous = exists(/databases/$(database)/documents/draftAttachments/$(uid))
        ? get(/databases/$(database)/documents/draftAttachments/$(uid)).data : {'count': 0, 'bytes': 0};
      let added = getAfter(/databases/$(database)/documents/draftAttachments/$(uid)/files/$(documentId)).data;
      return data.keys().hasAll(['count', 'bytes', 'lastDocumentId', 'updatedAt'])
        && data.keys().hasOnly(['count', 'bytes', 'lastDocumentId', 'updatedAt', 'videoCount'])
        && documentId is string && documentId.matches('[a-f0-9]{64}')
        && !exists(/databases/$(database)/documents/draftAttachments/$(uid)/files/$(documentId))
        && data.get('videoCount', 0) is int
        && data.get('videoCount', 0) == previous.get('videoCount', 0) + (isVideo(added) ? 1 : 0)
        && data.get('videoCount', 0) <= 1
        && data.count is int && data.count == previous.count + 1
        && data.count - data.get('videoCount', 0) <= 20
        && data.bytes is int && data.bytes == previous.bytes + added.size && data.bytes <= 52428800
        && data.updatedAt == request.time;
    }
    match /draftAttachments/{uid} {
      allow get: if draftOwner(uid);
      allow create, update: if draftOwner(uid)
        && !exists(/databases/$(database)/documents/consultationSubmissions/$(uid))
        && !existsAfter(/databases/$(database)/documents/consultationSubmissions/$(uid))
        && validAttachmentQuota(request.resource.data, uid);
      match /files/{documentId} {
        allow get: if draftOwner(uid);
        allow list: if draftOwner(uid) && request.query.limit != null && request.query.limit <= 21;
        allow create: if draftOwner(uid) && validAttachment(request.resource.data, uid, documentId)
          && !exists(/databases/$(database)/documents/consultationSubmissions/$(uid))
          && !existsAfter(/databases/$(database)/documents/consultationSubmissions/$(uid))
          && getAfter(/databases/$(database)/documents/draftAttachments/$(uid)).data.lastDocumentId == documentId
          && getAfter(/databases/$(database)/documents/draftAttachments/$(uid)).data.updatedAt == request.time;
      }
    }
    function clinicRole(country, role) {
      let staff = get(/databases/$(database)/documents/panelStaff/$(request.auth.uid)).data;
      let access = request.auth.token.panelAccess;
      return request.auth != null && request.auth.token.email_verified == true && country == 'CL'
        && access.version == 1 && access.active == true && role in access.memberships.get(country, [])
        && staff.active == true && staff.provisioning == 'ready' && role in staff.memberships.get(country, []);
    }
    function clinicReader(country) {
      return clinicRole(country, 'superadmin') || clinicRole(country, 'operations') || clinicRole(country, 'medicalDirector');
    }
    function clinicText(value, minimum, maximum) {
      return value is string && value.size() >= minimum && value.size() <= maximum
        && (value == '' || value.matches('[^\\s]([\\s\\S]*[^\\s])?'));
    }
    function clinicShape(data, id) {
      return data.keys().hasAll(['id', 'countryCode', 'schemaVersion', 'environment', 'code', 'name', 'description', 'city', 'address', 'email', 'phone', 'active', 'revision', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['id', 'countryCode', 'schemaVersion', 'environment', 'code', 'name', 'description', 'city', 'address', 'email', 'phone', 'active', 'revision', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && data.countryCode == 'CL' && data.schemaVersion == 1 && data.environment == 'development'
        && data.code is string && data.code.matches('[a-z][a-z0-9_]{1,31}')
        && data.id == id && id == 'CL_' + data.code
        && clinicText(data.name, 2, 100) && clinicText(data.description, 0, 500)
        && clinicText(data.city, 2, 100) && clinicText(data.address, 5, 200)
        && clinicText(data.email, 0, 254) && (data.email == '' || data.email.matches('[A-Za-z0-9_%+-]+([.][A-Za-z0-9_%+-]+)*@[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?([.][A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*[.][A-Za-z]{2,63}'))
        && data.phone is string && (data.phone == '' || data.phone.matches('[+][1-9][0-9]{7,14}'))
        && data.active is bool && data.revision is int && data.revision > 0
        && data.updatedBy == request.auth.uid && data.updatedAt == request.time;
    }
    function clinicAction(data, id) {
      return !exists(/databases/$(database)/documents/clinics/$(id)) ? 'create'
        : data.active == get(/databases/$(database)/documents/clinics/$(id)).data.active ? 'edit'
        : data.active ? 'reactivate' : 'deactivate';
    }
    function clinicAudit(data, id) {
      let event = getAfter(/databases/$(database)/documents/clinics/$(id)/events/$(string(data.revision))).data;
      return event.keys().hasAll(['revision', 'actorId', 'countryCode', 'action', 'recordedAt', 'snapshot'])
        && event.keys().hasOnly(['revision', 'actorId', 'countryCode', 'action', 'recordedAt', 'snapshot'])
        && event.revision == data.revision && event.actorId == request.auth.uid
        && event.countryCode == data.countryCode && event.recordedAt == request.time
        && event.action == clinicAction(data, id) && event.snapshot == data;
    }
    match /clinics/{id} {
      allow get: if (exists(/databases/$(database)/documents/clinics/$(id)) && clinicReader(resource.data.countryCode))
        || (!exists(/databases/$(database)/documents/clinics/$(id)) && id.matches('CL_[a-z][a-z0-9_]{1,31}') && clinicReader('CL'));
      allow list: if request.query.limit != null && request.query.limit <= 21 && clinicReader(resource.data.countryCode);
      allow create: if clinicRole(request.resource.data.countryCode, 'superadmin')
        && clinicShape(request.resource.data, id) && request.resource.data.revision == 1
        && request.resource.data.active == true && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time && clinicAudit(request.resource.data, id);
      allow update: if clinicRole(resource.data.countryCode, 'superadmin') && clinicShape(request.resource.data, id)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'city', 'address', 'email', 'phone', 'active', 'revision', 'updatedBy', 'updatedAt'])
        && (request.resource.data.active == resource.data.active
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'revision', 'updatedBy', 'updatedAt']))
        && clinicAudit(request.resource.data, id);
      match /events/{revision} {
        allow get: if clinicReader(get(/databases/$(database)/documents/clinics/$(id)).data.countryCode);
        allow list: if request.query.limit != null && request.query.limit <= 50
          && clinicReader(get(/databases/$(database)/documents/clinics/$(id)).data.countryCode);
        allow create: if clinicRole(request.resource.data.countryCode, 'superadmin')
          && revision == string(request.resource.data.revision)
          && request.resource.data.revision == (!exists(/databases/$(database)/documents/clinics/$(id)) ? 1
            : get(/databases/$(database)/documents/clinics/$(id)).data.revision + 1)
          && clinicAudit(getAfter(/databases/$(database)/documents/clinics/$(id)).data, id);
      }
    }
    function specialtyRole(country, role) {
      let staff = get(/databases/$(database)/documents/panelStaff/$(request.auth.uid)).data;
      let access = request.auth.token.panelAccess;
      return request.auth != null && request.auth.token.email_verified == true && country == 'CL'
        && access.version == 1 && access.active == true && role in access.memberships.get(country, [])
        && staff.active == true && staff.provisioning == 'ready' && role in staff.memberships.get(country, []);
    }
    function specialtyReader(country) {
      return specialtyRole(country, 'superadmin') || specialtyRole(country, 'operations') || specialtyRole(country, 'medicalDirector');
    }
    function specialtyText(value, minimum, maximum) {
      return value is string && value.size() >= minimum && value.size() <= maximum
        && (value == '' || value.matches('[^\\s]([\\s\\S]*[^\\s])?'));
    }
    function specialtyShape(data, id) {
      return data.keys().hasAll(['id', 'countryCode', 'schemaVersion', 'environment', 'code', 'name', 'description', 'active', 'revision', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['id', 'countryCode', 'schemaVersion', 'environment', 'code', 'name', 'description', 'active', 'revision', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && data.countryCode == 'CL' && data.schemaVersion == 1 && data.environment == 'development'
        && data.code is string && data.code.matches('[a-z][a-z0-9_]{1,31}')
        && data.id == id && id == 'CL_' + data.code
        && specialtyText(data.name, 2, 100) && specialtyText(data.description, 0, 500)
        && data.active is bool && data.revision is int && data.revision > 0
        && data.updatedBy == request.auth.uid && data.updatedAt == request.time;
    }
    function specialtyAction(data, id) {
      return !exists(/databases/$(database)/documents/specialties/$(id)) ? 'create'
        : data.active == get(/databases/$(database)/documents/specialties/$(id)).data.active ? 'edit'
        : data.active ? 'reactivate' : 'deactivate';
    }
    function specialtyAudit(data, id) {
      let event = getAfter(/databases/$(database)/documents/specialties/$(id)/events/$(string(data.revision))).data;
      return event.keys().hasAll(['revision', 'actorId', 'countryCode', 'action', 'recordedAt', 'snapshot'])
        && event.keys().hasOnly(['revision', 'actorId', 'countryCode', 'action', 'recordedAt', 'snapshot'])
        && event.revision == data.revision && event.actorId == request.auth.uid
        && event.countryCode == data.countryCode && event.recordedAt == request.time
        && event.action == specialtyAction(data, id) && event.snapshot == data;
    }
    match /specialties/{id} {
      allow get: if (exists(/databases/$(database)/documents/specialties/$(id)) && specialtyReader(resource.data.countryCode))
        || (!exists(/databases/$(database)/documents/specialties/$(id)) && id.matches('CL_[a-z][a-z0-9_]{1,31}') && specialtyReader('CL'));
      allow list: if request.query.limit != null && request.query.limit <= 21 && specialtyReader(resource.data.countryCode);
      allow create: if specialtyRole(request.resource.data.countryCode, 'superadmin')
        && specialtyShape(request.resource.data, id) && request.resource.data.revision == 1
        && request.resource.data.active == true && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time && specialtyAudit(request.resource.data, id);
      allow update: if specialtyRole(resource.data.countryCode, 'superadmin') && specialtyShape(request.resource.data, id)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'active', 'revision', 'updatedBy', 'updatedAt'])
        && (request.resource.data.active == resource.data.active
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'revision', 'updatedBy', 'updatedAt']))
        && specialtyAudit(request.resource.data, id);
      match /events/{revision} {
        allow get: if specialtyReader(get(/databases/$(database)/documents/specialties/$(id)).data.countryCode);
        allow list: if request.query.limit != null && request.query.limit <= 50
          && specialtyReader(get(/databases/$(database)/documents/specialties/$(id)).data.countryCode);
        allow create: if specialtyRole(request.resource.data.countryCode, 'superadmin')
          && revision == string(request.resource.data.revision)
          && request.resource.data.revision == (!exists(/databases/$(database)/documents/specialties/$(id)) ? 1
            : get(/databases/$(database)/documents/specialties/$(id)).data.revision + 1)
          && specialtyAudit(getAfter(/databases/$(database)/documents/specialties/$(id)).data, id);
      }
    }
    function doctorRole(country, role) {
      let staff = get(/databases/$(database)/documents/panelStaff/$(request.auth.uid)).data;
      let access = request.auth.token.panelAccess;
      return request.auth != null && request.auth.token.email_verified == true
        && access.version == 1 && access.active == true
        && role in access.memberships.get(country, [])
        && staff.active == true && staff.provisioning == 'ready'
        && role in staff.memberships.get(country, []);
    }
    function doctorReader(country) {
      return doctorRole(country, 'operations') || doctorRole(country, 'medicalDirector');
    }
    function doctorText(value, minimum, maximum) {
      return value is string && value.size() >= minimum && value.size() <= maximum
        && value.matches('[^\\s]([\\s\\S]*[^\\s])?');
    }
    function doctorSpecialty(data, matchName) {
      let specialty = get(/databases/$(database)/documents/specialties/$(data.specialtyId)).data;
      return data.schemaVersion == 2
        && specialty.countryCode == data.countryCode && specialty.active == true
        && (!matchName || specialty.name == data.specialty);
    }
    function doctorShape(data, id) {
      return data.keys().hasAll(['id', 'countryCode', 'schemaVersion', 'environment', 'name', 'registryNumber', 'specialty', 'status', 'review', 'revision', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['id', 'countryCode', 'schemaVersion', 'environment', 'name', 'registryNumber', 'specialty', 'specialtyId', 'status', 'review', 'revision', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && data.countryCode == 'CL' && data.environment == 'development'
        && ((data.schemaVersion == 1 && !('specialtyId' in data))
          || (data.schemaVersion == 2 && data.specialtyId is string && data.specialtyId.matches('CL_[a-z][a-z0-9_]{1,31}')))
        && data.registryNumber is string && data.registryNumber.matches('[1-9][0-9]{0,9}')
        && data.id == id && id == 'CL_' + data.registryNumber
        && doctorText(data.name, 3, 120) && doctorText(data.specialty, 2, 120)
        && data.status in ['pending', 'verified', 'rejected', 'suspended']
        && data.review is map && data.revision is int && data.revision > 0
        && data.updatedBy == request.auth.uid && data.updatedAt == request.time;
    }
    function doctorAudit(data, id) {
      let event = getAfter(/databases/$(database)/documents/doctorRecords/$(id)/events/$(string(data.revision))).data;
      return event.keys().hasAll(['revision', 'actorId', 'countryCode', 'action', 'recordedAt', 'snapshot'])
        && event.keys().hasOnly(['revision', 'actorId', 'countryCode', 'action', 'recordedAt', 'snapshot'])
        && event.revision == data.revision && event.actorId == request.auth.uid
        && event.countryCode == data.countryCode && event.recordedAt == request.time
        && event.action == (data.revision == 1 ? 'create' : (data.status == 'pending' ? 'edit' : 'review'))
        && event.snapshot == data;
    }
    function doctorReview(data, previous) {
      let review = data.review;
      return doctorRole(data.countryCode, 'medicalDirector') && request.auth.uid != data.createdBy
        && ((previous.status == 'pending' && data.status in ['verified', 'rejected'])
          || (previous.status == 'verified' && data.status == 'suspended')
          || (previous.status == 'suspended' && data.status in ['verified', 'rejected']))
        && data.diff(previous).affectedKeys().hasOnly(['status', 'review', 'revision', 'updatedBy', 'updatedAt'])
        && review.keys().hasAll(['actorId', 'at', 'source', 'evidence', 'note', 'identityChecked', 'titleChecked', 'specialtyChecked'])
        && review.keys().hasOnly(['actorId', 'at', 'source', 'evidence', 'note', 'identityChecked', 'titleChecked', 'specialtyChecked'])
        && review.actorId == request.auth.uid && review.at == request.time && review.source == 'CL_RNPI'
        && doctorText(review.evidence, 3, 200) && doctorText(review.note, 10, 2000)
        && review.identityChecked is bool && review.titleChecked is bool && review.specialtyChecked is bool
        && (data.status != 'verified' || (review.identityChecked && review.titleChecked && review.specialtyChecked && doctorSpecialty(data, false)));
    }
    match /doctorRecords/{id} {
      allow get: if (exists(/databases/$(database)/documents/doctorRecords/$(id)) && doctorReader(resource.data.countryCode))
        || (!exists(/databases/$(database)/documents/doctorRecords/$(id)) && id.matches('CL_[1-9][0-9]{0,9}') && doctorReader('CL'));
      allow list: if request.query.limit != null && request.query.limit <= 21 && doctorReader(resource.data.countryCode);
      allow create: if doctorRole(request.resource.data.countryCode, 'operations')
        && doctorShape(request.resource.data, id) && doctorSpecialty(request.resource.data, true) && request.resource.data.revision == 1
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'pending' && request.resource.data.review == {}
        && doctorAudit(request.resource.data, id);
      allow update: if doctorShape(request.resource.data, id)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.registryNumber == resource.data.registryNumber
        && doctorAudit(request.resource.data, id)
        && ((doctorRole(resource.data.countryCode, 'operations')
            && resource.data.status in ['pending', 'rejected'] && request.resource.data.status == 'pending'
            && request.resource.data.review == {} && doctorSpecialty(request.resource.data, true)) || doctorReview(request.resource.data, resource.data));
      match /events/{revision} {
        allow get: if doctorReader(get(/databases/$(database)/documents/doctorRecords/$(id)).data.countryCode);
        allow list: if request.query.limit != null && request.query.limit <= 50
          && doctorReader(get(/databases/$(database)/documents/doctorRecords/$(id)).data.countryCode);
        allow create: if doctorReader(request.resource.data.countryCode)
          && revision == string(request.resource.data.revision)
          && (!exists(/databases/$(database)/documents/doctorRecords/$(id))
            || request.resource.data.revision == get(/databases/$(database)/documents/doctorRecords/$(id)).data.revision + 1)
          && doctorAudit(getAfter(/databases/$(database)/documents/doctorRecords/$(id)).data, id);
      }
    }
    match /patientNotices/{uid}/items/{noticeId} {
      allow get: if draftOwner(uid);
      allow list: if draftOwner(uid) && request.query.limit != null && request.query.limit <= 100;
      allow update: if draftOwner(uid)
        && resource.data.recipientId == uid && resource.data.id == noticeId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.keys().hasAll(['readAt'])
        && (request.resource.data.readAt == null || request.resource.data.readAt == request.time);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
